      "name": "1. GET 404 (MISS)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Content-Type image/jpeg\", () =>",
              "  pm.expect(pm.response.headers.get(\"Content-Type\")).to.eql(\"image/jpeg\"));",
              "pm.test(\"X-Cache is MISS\", () =>",
              "  pm.expect(pm.response.headers.get(\"X-Cache\")).to.eql(\"MISS\"));",
              "console.log(\"Response time (MISS):\", pm.response.responseTime, \"ms\");"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
